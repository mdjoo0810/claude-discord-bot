# ── Discord ────────────────────────────────────────────────────────────────
# Developer Portal > Bot > Token
DISCORD_TOKEN=
# Developer Portal > General Information > Application ID
DISCORD_CLIENT_ID=
# 슬래시 커맨드를 즉시 반영하려면 서버(길드) ID 지정. 비우면 글로벌 등록(반영에 최대 1시간)
DISCORD_GUILD_ID=

# ── 접근 제어 (필수) ────────────────────────────────────────────────────────
# 봇을 사용할 수 있는 Discord 유저 ID (쉼표 구분). 비우면 아무도 못 씀 (fail-closed)
ALLOWED_USER_IDS=
# 새 세션을 시작할 수 있는 채널 ID (쉼표 구분). 비우면 봇이 보이는 모든 채널 허용
ALLOWED_CHANNEL_IDS=

# ── 작업 대상 ──────────────────────────────────────────────────────────────
# 이 경로 바로 아래 폴더들이 프로젝트 목록이 됩니다
PROJECTS_ROOT=/Users/myeongdonjoo/dev
# /code 커맨드에서 project를 생략했을 때 쓸 기본 프로젝트 폴더명
DEFAULT_PROJECT=

# ── Claude 실행 옵션 ───────────────────────────────────────────────────────
# 비우면 Claude Code 기본 모델 사용
CLAUDE_MODEL=
# low | medium | high | xhigh | max
CLAUDE_EFFORT=high
# 한 번의 요청에서 허용할 최대 에이전트 턴 수
MAX_TURNS=200
# 한 번의 요청에서 넘지 않을 예상 비용(USD). 비우면 무제한
MAX_BUDGET_USD=

# ── 운영 ───────────────────────────────────────────────────────────────────
# 동시에 실행할 수 있는 최대 세션 수 (맥 리소스 보호)
MAX_CONCURRENT_RUNS=3
# 권한 승인 버튼 대기 시간(ms). 초과하면 자동 거부
APPROVAL_TIMEOUT_MS=600000
# 스레드 안에서 봇을 멘션해야만 반응할지 여부
REQUIRE_MENTION_IN_THREAD=true
# 새 스레드를 자동 승인 상태로 시작할지 여부.
# true 로 두면 매번 /code 에 auto 를 붙이지 않아도 승인 버튼 없이 실행됩니다.
# (rm -rf /, sudo 같은 하드 차단 규칙은 이 설정과 무관하게 계속 적용됩니다.)
AUTO_APPROVE_DEFAULT=false
# 상태줄(모델/컨텍스트/사용량) 표시 위치
#   status = 진행·완료 메시지에만 (기본, 실시간 갱신)
#   all    = 모든 답변 메시지 하단에도 붙임
#   off    = 표시 안 함
STATUS_LINE=status

# 상태줄에 5h/7d 사용률(%)을 넣으려면 JSON 을 출력하는 명령을 지정하세요.
# Agent SDK 의 rate_limit_event 는 리셋 시각은 주지만 사용률 %는 주지 않습니다.
# 이미 설치된 claude-dashboard 를 그대로 쓸 수 있습니다:
# USAGE_COMMAND=node ~/.claude/plugins/marketplaces/claude-dashboard/dist/check-usage.js --json
USAGE_COMMAND=
USAGE_CACHE_SECONDS=120
USAGE_TIMEOUT_MS=8000
DB_PATH=./data/bot.db
LOG_LEVEL=info
